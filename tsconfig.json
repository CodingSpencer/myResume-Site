{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "types": ["astro/client"],
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.astro",
        ".astro/types.d.ts",
        "server/**/*.js",
        "vite.config.*"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ]
}
