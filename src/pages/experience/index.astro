---
import MainLayout from "../../layouts/Main.astro";
import resumeData from "../../data/resume.js";
---

<MainLayout title="Experience">
        <header class="page-header">
            <p class="eyebrow">Work History</p>
            <h1>Experience</h1>
            <p class="lead">
                A summary of my work expereinces including positions I've held, projects I've worked on, and the time period I worked there.
            </p>
        </header>

        <div class="experience-list">
            {resumeData.experience.map((job) => (
                <article class="experience-item">
                    <header class="experience-header">
                        <div class="experience-title-group">
                            <h2 class="experience-title">{job.title}</h2>
                            <p class="experience-company">{job.company}</p>
                        </div>
                        <div class="experience-meta">
                            <span class="experience-location">{job.location}</span>
                            <span class="experience-date">{job.date}</span>
                        </div>
                    </header>
                    <ul class="experience-bullets">
                        {job.bullets.map((bullet) => (
                            <li>{bullet}</li>
                        ))}
                    </ul>
                </article>
            ))}
        </div>
</MainLayout>

<style>
    .page-header {
        margin-bottom: 2rem;
    }

    .eyebrow {
        margin: 0;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent, #2563eb);
    }

    h1 {
        margin: 0.25rem 0 0;
        font-size: clamp(2rem, 5vw, 3.25rem);
        line-height: 1.1;
    }

    .lead {
        margin: 0.75rem 0 0;
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--color-muted, #4b5563);
    }

    .experience-list {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    .experience-item {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.5rem;
        background: var(--color-bg-secondary, #f3f4f6);
        border: 1px solid var(--color-border, #e5e7eb);
        border-left: 4px solid var(--color-accent, #2563eb);
        border-radius: 8px;
    }

    .experience-header {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .experience-title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
    }

    .experience-company {
        margin: 0;
        font-size: 1rem;
        font-weight: 500;
        color: var(--color-accent, #2563eb);
    }

    .experience-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        font-size: 0.9rem;
        color: var(--color-muted, #6b7280);
    }

    .experience-bullets {
        margin: 0;
        padding-left: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    @media (min-width: 768px) {
        .experience-header {
            flex-direction: row;
            justify-content: space-between;
            align-items: flex-start;
        }

        .experience-meta {
            text-align: right;
        }
    }
</style>