---
import MainLayout from "../../layouts/Main.astro";
import resumeData from "../../data/resume.js";
import { ICONS } from "../../data/icons.js";
---

<MainLayout title="Contact">
    <div class="page">
        <header class="page-header">
            <p class="eyebrow">Get in Touch</p>
            <h1>Contact</h1>
            <p class="lead">
                Reach out through any of the channels below. I'm happy to connect.
            </p>
        </header>

        <div class="contact-grid">
            <a class="contact-card" href={`mailto:${resumeData.contact.email}`}>
                <span class="contact-icon" set:html={ICONS.email} />
                <span class="contact-title">Email</span>
                <span class="contact-value">{resumeData.contact.email}</span>
            </a>

            <a class="contact-card" href={`tel:${resumeData.contact.phone}`}>
                <span class="contact-icon" set:html={ICONS.phone} />
                <span class="contact-title">Phone</span>
                <span class="contact-value">{resumeData.contact.phone}</span>
            </a>

            <a
                class="contact-card"
                href={resumeData.contact.linkedin}
                target="_blank"
                rel="noopener noreferrer"
            >
                <span class="contact-icon" set:html={ICONS.linkedin} />
                <span class="contact-title">LinkedIn</span>
                <span class="contact-value">Connect with me</span>
            </a>
        </div>
    </div>
</MainLayout>

<style>
    .page {
        max-width: clamp(20rem, 90vw, 60rem);
        margin: 0 auto;
        padding: 2.5rem 3rem;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .eyebrow {
        margin: 0;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent, #2563eb);
    }

    h1 {
        margin: 0.25rem 0 0;
        font-size: clamp(2rem, 5vw, 3.25rem);
        line-height: 1.1;
    }

    .lead {
        margin: 0.75rem 0 0;
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--color-muted, #4b5563);
    }

    .contact-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
    }

    .contact-card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.5rem;
        background: var(--color-bg-secondary, #f3f4f6);
        border: 1px solid var(--color-border, #e5e7eb);
        border-radius: 8px;
        text-decoration: none;
        transition: border-color 0.2s, background 0.2s, transform 0.2s ease;
    }

    .contact-card:hover {
        border-color: var(--color-accent, #2563eb);
        background: var(--color-bg, #fff);
        transform: translateY(-2px);
    }

    .contact-icon {
        display: inline-flex;
        width: 40px;
        height: 40px;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: var(--color-bg, #fff);
        border: 1px solid var(--color-border, #d1d5db);
        color: var(--color-accent, #2563eb);
    }

    .contact-icon :global(svg) {
        width: 20px;
        height: 20px;
    }

    .contact-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--color-text, #111827);
    }

    .contact-value {
        font-size: 0.95rem;
        color: var(--color-muted, #4b5563);
        overflow-wrap: anywhere;
    }
</style>