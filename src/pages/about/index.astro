---
import MainLayout from "../../layouts/Main.astro";
---

<MainLayout title="Sandbox">
        <header class="page-header">
            <p class="eyebrow">Getting to Know Me</p>
            <h1>About Me</h1>
            <p class="lead">
                More informaiton about me coming soon.
            </p>
        </header>
</MainLayout>

<style>
    .page-header {
        margin-bottom: 2rem;
    }

    .eyebrow {
        margin: 0;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent, #2563eb);
    }

    h1 {
        margin: 0.25rem 0 0;
        font-size: clamp(2rem, 5vw, 3.25rem);
        line-height: 1.1;
    }

    .lead {
        margin: 0.75rem 0 0;
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--color-muted, #4b5563);
    }

    .placeholder-box {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.5rem;
        background: var(--color-bg-secondary, #f3f4f6);
        border: 1px dashed var(--color-border, #d1d5db);
        border-radius: 8px;
    }

    .placeholder-title {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 600;
    }

    .placeholder-body {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--color-muted, #4b5563);
    }
</style>