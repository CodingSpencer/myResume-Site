---
import MainLayout from "../layouts/Main.astro";
---

<MainLayout title="Home">
    <section class="home">
        <p class="eyebrow">Portfolio</p>
        <h1>Spencer’s Resume</h1>
        <p class="lead">
            This is a placeholder home page for the site. Use the sidebar to jump between sections,
            or open the full resume to view the current profile.
        </p>

        <div class="actions">
            <a class="button button--primary" href="/resume">View resume</a>
            <a class="button button--secondary" href="/experience">Explore experience</a>
        </div>
    </section>
</MainLayout>

<style>
    .home {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 60vh;
        max-width: 640px;
        gap: 1rem;
    }

    .eyebrow {
        margin: 0;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent, #2563eb);
    }

    h1 {
        margin: 0;
        font-size: clamp(2.25rem, 5vw, 4rem);
        line-height: 1.1;
    }

    .lead {
        margin: 0;
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--color-muted, #4b5563);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 0.5rem;
    }

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0.75rem 1.25rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .button:hover {
        transform: translateY(-1px);
    }

    .button--primary {
        background: var(--color-accent, #2563eb);
        color: white;
    }

    .button--secondary {
        border: 1px solid var(--color-border, #d1d5db);
        color: var(--color-text, #111827);
        background: transparent;
    }
</style>
