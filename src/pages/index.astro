---
import MainLayout from "../layouts/Main.astro";
import { Image } from "astro:assets";
import headshot from "../assets/imgs/Professional/Resume_Headshot.jpg";
---

<MainLayout title="Home">
        <section class="home">
        <p class="eyebrow">Home</p>
        <h1>Spencer’s Website</h1>
        <div class="home__body">
            <Image
                class="home__portrait"
                src={headshot}
                alt="Spencer’s headshot"
                width={300}
                format="webp"
                quality={90}
                densities={[1, 2]}
            />
            <div class="home__lead">
                <p class="lead"> Welcome to my website!<br><br> 
                    I'm a software engineer and a paralegal, and I love building projects with new technologies to help make different tasks easier for different people. I will graduate with a bachelor's degree in Software Engineering from BYU-Idaho in Fall 2026, and I've loved my time there. My specialties during my time at BYU-Idaho have been Linux, web development, and database/backend development.<br><br> 
                    I've been taking classes remotely while working as a paralegal in Utah County. I love all things movies, disc golf, ping pong, and Linux! Whenever I'm not doing one of those things, I'm usually spending time with my wife, family, or friends. 
                </p>
                <p><b>To learn more about me visit my <a class="button--link" href="/about">About Me</a> page.</b></p>
            </div>
        </div>
    </section>
</MainLayout>

<style>
    .home {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 60vh;
        max-width: 960px;
        gap: 1rem;
    }

    .home__body {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: 2rem;
    }

    .home__lead {
        flex: 1 1 260px;
        min-width: 0;
        order: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .home__portrait {
        flex: 0 0 auto;
        order: 1;
        width: clamp(160px, 28vw, 300px);
        height: clamp(160px, 28vw, 300px);
        border-radius: 50%;
        object-fit: cover;
        object-position: 50% 25%;
        border: 8px solid var(--color-image-border, #0094c6);
        box-shadow: 8px 8px 24px rgba(0, 0, 22, 0.25), 0 2px 8px rgba(0, 0, 22, 0.15);
    }

    .eyebrow {
        margin: 0;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent, #2563eb);
    }

    h1 {
        margin: 0;
        font-size: clamp(2.25rem, 5vw, 4rem);
        line-height: 1.1;
    }

    .lead {
        margin: 0;
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--color-muted, #4b5563);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 0.5rem;
    }

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0.75rem 1.25rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .button:hover {
        transform: translateY(-1px);
    }

    .button--primary {
        background: var(--color-accent, #2563eb);
        color: white;
    }

    .button--secondary {
        border: 1px solid var(--color-border, #d1d5db);
        color: var(--color-text, #111827);
        background: transparent;
    }

    .button--link {
        display: inline-block;
        padding: 0.5rem 1rem;
        background-color: var(--color-accent, #2563eb);
        color: #fff;
        text-decoration: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .button--link:hover {
        background-color: var(--color-accent-dark, #1d4ed8);
    }

</style>
